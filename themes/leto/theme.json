{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:djhonza-byte/lg-domov:leto",
  "title": "Léto u Máchova jezera",
  "description": "Lodičky, kemp a lesnatý protější břeh; ilustrační výhled inspirovaný Máchovým jezerem. Motiv: dubové okno, světlé závěsy a klidné spodní menu.",
  "author": {
    "name": "LG Domov / djhonza-byte",
    "url": "https://github.com/djhonza-byte/LG-Domov"
  },
  "themeVersion": "1.0.1",
  "layout": {
    "preset": "scenic-grid",
    "columns": 6,
    "allowColumnOverride": false,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "ribbon": {
      "left": 96,
      "right": 96,
      "bottom": 78,
      "cardHeight": 128,
      "gap": 20,
      "skewDeg": 0,
      "focusLift": 8,
      "iconScale": 0.85,
      "shortcuts": "header",
      "edgeNavigation": "wrap",
      "labels": "below",
      "showClock": true
    }
  },
  "defaults": {
    "wallpaperAssetId": "wallpaper",
    "dim": 0.06,
    "accent": "#89C6BD"
  },
  "assets": [
    {
      "id": "wallpaper",
      "path": "assets/wallpaper.jpg",
      "mediaType": "image/jpeg",
      "width": 1672,
      "height": 941
    },
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 480,
      "height": 270
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  }
}
